{
  "name": "sifr-site",
  "compatibility_date": "2026-02-28",
  "main": "./src/worker.js",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "sifr.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/install"
    ],
    "not_found_handling": "404-page"
  }
}
