---
const githubUrl = 'https://github.com/yaseralnajjar/sifr';
const year = new Date().getFullYear();
---

<footer class="bg-zinc-900 text-zinc-300 border-t border-zinc-800 mt-20 relative z-10" id="footer">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-16 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="flex flex-col gap-4 md:col-span-2">
      <div class="flex items-center gap-2 text-white">
        <img
          src="/logo.webp"
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 object-contain"
          decoding="async"
          aria-hidden="true"
        />
        <span class="font-display font-semibold tracking-wider">sifr.sh</span>
      </div>
      <p class="text-xs text-zinc-400 leading-normal max-w-sm">
        Python ergonomics compiled into safe native binaries. No virtual VMs, no GC layers, and minimal runtime crashes.
      </p>
    </div>

    <nav class="flex flex-col gap-2 text-xs" aria-label="Footer">
      <span class="text-zinc-100 font-bold uppercase tracking-widest font-mono text-[10px] mb-2">Community &amp; Code</span>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
        GitHub repository
        <span class="sr-only"> (opens in new tab)</span>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href="/#pipeline" class="hover:text-white transition-colors">Documentation</a>
      <span class="text-[10px] text-zinc-400 mt-4">&copy; {year} Sifr project.</span>
    </nav>
  </div>
</footer>
