---
const githubUrl = 'https://github.com/yaseralnajjar/sifr';
const year = new Date().getFullYear();
---

<footer class="bg-zinc-900 text-zinc-400 border-t border-zinc-800 mt-20 relative z-10" id="footer">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-16 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="flex flex-col gap-4 md:col-span-2">
      <div class="flex items-center gap-2 text-white">
        <svg
          class="w-7 h-7"
          viewBox="0 0 512 512"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="sifrTealBodyFooter" x1="100" y1="100" x2="412" y2="412" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#06b6d4" />
              <stop offset="35%" stop-color="#0ea5e9" />
              <stop offset="70%" stop-color="#0284c7" />
              <stop offset="100%" stop-color="#1e3a8a" />
            </linearGradient>
            <linearGradient id="sifrOrangeAccentFooter" x1="180" y1="90" x2="430" y2="180" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fbbf24" />
              <stop offset="50%" stop-color="#f97316" />
              <stop offset="100%" stop-color="#ea580c" />
            </linearGradient>
            <linearGradient id="sifrShadowOverlayFooter" x1="256" y1="120" x2="256" y2="450" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
              <stop offset="100%" stop-color="#000000" stop-opacity="0.25" />
            </linearGradient>
          </defs>
          <path
            d="M 190 180 C 200 160, 240 150, 270 155 C 340 165, 395 220, 395 300 C 395 385, 315 450, 240 435 C 170 420, 115 350, 115 270 C 115 210, 150 150, 195 125 C 165 155, 140 215, 145 275 C 150 335, 190 385, 250 395 C 305 405, 360 360, 360 300 C 360 235, 310 190, 250 180 C 225 175, 205 178, 190 180 Z"
            fill="url(#sifrTealBodyFooter)"
          />
          <path
            d="M 150 270 C 150 350, 210 400, 280 400 C 350 400, 410 330, 410 256 C 410 180, 350 120, 280 120 C 240 120, 200 135, 180 160 C 210 140, 260 135, 300 145 C 360 160, 390 220, 390 275 C 390 340, 330 385, 266 385 C 200 385, 160 340, 150 270 Z"
            fill="url(#sifrShadowOverlayFooter)"
          />
          <path
            d="M 190 180 C 188 150, 210 115, 250 100 C 290 85, 360 105, 395 145 C 415 170, 420 185, 418 188 C 415 190, 400 185, 390 175 C 375 160, 350 145, 310 135 C 280 128, 250 132, 230 145 C 205 160, 195 175, 190 180 Z"
            fill="url(#sifrOrangeAccentFooter)"
          />
          <path
            d="M 380 135 C 390 145, 412 165, 418 185 C 422 190, 420 193, 415 190 C 410 185, 395 180, 385 175 C 365 165, 345 155, 325 150 C 350 142, 365 138, 380 135 Z"
            fill="url(#sifrOrangeAccentFooter)"
          />
          <path
            d="M 115 310 C 105 310, 92 315, 85 308 C 95 315, 115 325, 130 345 C 145 365, 190 385, 220 395 C 195 385, 162 380, 142 360 C 125 340, 120 320, 115 310 Z"
            fill="url(#sifrOrangeAccentFooter)"
          />
        </svg>
        <span class="font-display font-semibold tracking-wider">sifr.sh</span>
      </div>
      <p class="text-xs text-zinc-500 leading-normal max-w-sm">
        Python ergonomics compiled into safe native binaries. No virtual VMs, no GC layers, and zero runtime crashes.
      </p>
    </div>

    <div class="flex flex-col gap-2 text-xs">
      <span class="text-zinc-200 font-bold uppercase tracking-widest font-mono text-[10px] mb-2">Community &amp; Code</span>
      <a href={githubUrl} target="_blank" rel="noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
        GitHub repository
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href="/#pipeline" class="hover:text-white transition-colors">Documentation</a>
      <span class="text-[10px] text-zinc-600 mt-4">&copy; {year} Sifr project.</span>
    </div>
  </div>
</footer>
