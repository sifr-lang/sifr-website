---
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/#pipeline', label: 'Docs' },
];

const githubUrl = 'https://github.com/yaseralnajjar/sifr';

type Props = {
  sticky?: boolean;
};

const { sticky = true } = Astro.props as Props;
---

<header
  class:list={[
    'sticky top-0 z-40 bg-zinc-50/80 backdrop-blur-md border-b border-zinc-200/60',
    { 'relative': !sticky },
  ]}
  id="header-nav"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a class="flex items-center gap-2 group" href="/" aria-label="Sifr home">
        <svg
          class="w-9 h-9 group-hover:scale-105 transition-transform"
          viewBox="0 0 512 512"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="sifrTealBodyHeader" x1="100" y1="100" x2="412" y2="412" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#06b6d4" />
              <stop offset="35%" stop-color="#0ea5e9" />
              <stop offset="70%" stop-color="#0284c7" />
              <stop offset="100%" stop-color="#1e3a8a" />
            </linearGradient>
            <linearGradient id="sifrOrangeAccentHeader" x1="180" y1="90" x2="430" y2="180" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fbbf24" />
              <stop offset="50%" stop-color="#f97316" />
              <stop offset="100%" stop-color="#ea580c" />
            </linearGradient>
            <linearGradient id="sifrShadowOverlayHeader" x1="256" y1="120" x2="256" y2="450" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
              <stop offset="100%" stop-color="#000000" stop-opacity="0.25" />
            </linearGradient>
          </defs>
          <path
            d="M 190 180 C 200 160, 240 150, 270 155 C 340 165, 395 220, 395 300 C 395 385, 315 450, 240 435 C 170 420, 115 350, 115 270 C 115 210, 150 150, 195 125 C 165 155, 140 215, 145 275 C 150 335, 190 385, 250 395 C 305 405, 360 360, 360 300 C 360 235, 310 190, 250 180 C 225 175, 205 178, 190 180 Z"
            fill="url(#sifrTealBodyHeader)"
          />
          <path
            d="M 150 270 C 150 350, 210 400, 280 400 C 350 400, 410 330, 410 256 C 410 180, 350 120, 280 120 C 240 120, 200 135, 180 160 C 210 140, 260 135, 300 145 C 360 160, 390 220, 390 275 C 390 340, 330 385, 266 385 C 200 385, 160 340, 150 270 Z"
            fill="url(#sifrShadowOverlayHeader)"
          />
          <path
            d="M 190 180 C 188 150, 210 115, 250 100 C 290 85, 360 105, 395 145 C 415 170, 420 185, 418 188 C 415 190, 400 185, 390 175 C 375 160, 350 145, 310 135 C 280 128, 250 132, 230 145 C 205 160, 195 175, 190 180 Z"
            fill="url(#sifrOrangeAccentHeader)"
          />
          <path
            d="M 380 135 C 390 145, 412 165, 418 185 C 422 190, 420 193, 415 190 C 410 185, 395 180, 385 175 C 365 165, 345 155, 325 150 C 350 142, 365 138, 380 135 Z"
            fill="url(#sifrOrangeAccentHeader)"
          />
          <path
            d="M 115 310 C 105 310, 92 315, 85 308 C 95 315, 115 325, 130 345 C 145 365, 190 385, 220 395 C 195 385, 162 380, 142 360 C 125 340, 120 320, 115 310 Z"
            fill="url(#sifrOrangeAccentHeader)"
          />
        </svg>
        <span class="font-display font-bold text-lg tracking-wider text-zinc-950">sifr</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-600" aria-label="Primary">
        {links.map((link) => (
          <a href={link.href} class="hover:text-zinc-950 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={githubUrl}
        target="_blank"
        rel="noreferrer"
        class="p-2 text-zinc-600 hover:text-zinc-950 hover:bg-zinc-200/50 rounded-lg transition-all"
        title="GitHub Repository"
        aria-label="GitHub Repository"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
      <a
        href="/#pipeline"
        class="hidden sm:inline-flex text-sm font-medium px-4 py-2 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg transition-colors shadow-sm"
      >
        Get Started
      </a>
    </div>
  </div>
</header>
