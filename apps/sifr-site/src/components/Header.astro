---
const links = [
  { href: '/', label: 'Home', match: (path: string) => path === '/' },
  { href: '/blog', label: 'Blog', match: (path: string) => path.startsWith('/blog') },
  { href: 'https://docs.sifr.sh', label: 'Docs', match: () => false },
];

const githubUrl = 'https://github.com/yaseralnajjar/sifr';
const pathname = Astro.url.pathname;

type Props = {
  sticky?: boolean;
};

const { sticky = true } = Astro.props as Props;

const isActive = (match: (path: string) => boolean) => match(pathname);
---

<header
  class:list={[
    'sticky top-0 z-40 bg-zinc-50/80 backdrop-blur-md border-b border-zinc-200/60',
    { 'relative': !sticky },
  ]}
  id="header-nav"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 sm:gap-8 min-w-0">
      <a class="flex items-center gap-2.5 group shrink-0" href="/" aria-label="Sifr home">
        <img
          src="/logo.webp"
          alt=""
          width="48"
          height="48"
          class="h-12 w-12 object-contain group-hover:scale-105 transition-transform"
          decoding="async"
          aria-hidden="true"
        />
        <span class="font-display font-bold text-3xl leading-none tracking-wide text-zinc-950">Sifr</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-base font-medium text-zinc-700" aria-label="Primary">
        {links.map((link) => {
          const active = isActive(link.match);
          return (
            <a
              href={link.href}
              class:list={[
                'hover:text-zinc-950 transition-colors rounded-sm',
                active ? 'font-bold text-zinc-950' : 'font-medium',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-2 sm:gap-4">
      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 text-zinc-700 hover:text-zinc-950 hover:bg-zinc-200/50 rounded-lg transition-all [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Open navigation menu</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16" />
            <path d="M4 12h16" />
            <path d="M4 18h16" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 min-w-40 rounded-xl border border-zinc-200 bg-white p-2 shadow-lg"
          aria-label="Primary mobile"
        >
          {links.map((link) => {
            const active = isActive(link.match);
            return (
              <a
                href={link.href}
                class:list={[
                  'block rounded-lg px-3 py-2 text-base hover:bg-zinc-100 hover:text-zinc-950',
                  active ? 'font-bold text-zinc-950' : 'font-medium text-zinc-700',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      </details>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-zinc-700 hover:text-zinc-950 hover:bg-zinc-200/50 rounded-lg transition-all"
        aria-label="GitHub repository (opens in new tab)"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
      <a
        href="https://docs.sifr.sh/installation"
        class="hidden sm:inline-flex text-sm font-medium px-4 py-2 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg transition-colors shadow-sm"
      >
        Get Started
      </a>
    </div>
  </div>
</header>
