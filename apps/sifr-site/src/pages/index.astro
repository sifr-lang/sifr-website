---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Sifr — Python syntax, Rust performance"
  description="Sifr is a compact, fast language runtime for people who want Python-like ergonomics with Rust-level execution speed."
  canonical="/"
  image="/logo.webp"
  imageAlt="Sifr logo"
  keywords={['sifr', 'programming language', 'python syntax', 'rust performance']}
>
  <section class="hero-section">
    <div class="hero-content">
      <img
        class="hero-logo"
        src="/logo.webp"
        alt="Sifr logo"
        width="96"
        height="96"
      />
      <h1 class="hero-title">Sifr</h1>
      <p class="hero-tagline">Python syntax. Rust performance.</p>
      <p class="hero-description">
        Sifr is a compact, fast language runtime for people who want Python-like
        ergonomics with Rust-level execution speed.
      </p>
      <div class="actions">
        <a
          class="button-link primary"
          href="https://github.com/yaseralnajjar/sifr"
          target="_blank"
          rel="noreferrer noopener"
        >
          Get started
        </a>
        <a class="button-link secondary" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</Layout>
