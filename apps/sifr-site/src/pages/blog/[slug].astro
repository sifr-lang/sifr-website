---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const { Content, headings } = await post.render();

const readingMinutes = estimateReadingMinutes(post.body);

const tableOfContents = headings
  .filter((heading) => heading.depth === 1 || heading.depth === 2)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    depth: heading.depth as 1 | 2,
  }));

const canonicalPath = `/blog/${post.slug}`;
const articlePublished = post.data.date.toISOString();
const articleModified = (post.data.updated ?? post.data.date).toISOString();
const articleKeywords = ['sifr', 'blog', ...(post.data.keywords ?? [])];
---

<Layout
  title={`${post.data.title} | Sifr blog`}
  description={post.data.excerpt}
  canonical={canonicalPath}
  image={post.data.ogImage ?? '/logo.webp'}
  imageAlt={post.data.ogImageAlt ?? post.data.title}
  type="article"
  author={post.data.author}
  publishedTime={articlePublished}
  modifiedTime={articleModified}
  keywords={articleKeywords}
  stickyHeader={false}
>
  <section class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_17rem] gap-8 lg:gap-12 items-start">
    <div class="min-w-0">
      <article class="bg-white border border-zinc-200/80 rounded-3xl p-6 md:p-10 shadow-sm">
        <header class="mb-8 pb-6 border-b border-zinc-200/80">
          <p class="m-0 mb-3 text-[11px] font-bold font-mono tracking-wider uppercase text-sky-700">
            {post.data.eyebrow ?? 'Engineering Notes'}
          </p>
          <h1 class="m-0 mb-4 font-display text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-950 leading-tight">
            {post.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-600">
            <time datetime={post.data.date.toISOString()}>
              {
                post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
            <span aria-hidden="true">•</span>
            <span>{readingMinutes} min read</span>
            {post.data.author && (
              <>
                <span aria-hidden="true">•</span>
                <span class="text-zinc-800 font-semibold">By {post.data.author}</span>
              </>
            )}
          </div>
        </header>
        <div class="blog-content text-zinc-700 text-base leading-relaxed [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:text-zinc-950 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pt-8 [&_h2]:border-t [&_h2]:border-zinc-200/80 [&_h2:first-of-type]:mt-4 [&_h2:first-of-type]:pt-0 [&_h2:first-of-type]:border-t-0 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-zinc-900 [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-4 [&_p]:text-zinc-600 [&_a]:text-sky-700 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-sky-800 [&_ul]:mb-4 [&_ol]:mb-4 [&_li]:text-zinc-600 [&_blockquote]:border-l-4 [&_blockquote]:border-sky-500 [&_blockquote]:bg-zinc-50 [&_blockquote]:rounded-r-xl [&_blockquote]:px-4 [&_blockquote]:py-3 [&_blockquote]:italic [&_blockquote]:text-zinc-600 [&_:not(pre)>code]:bg-zinc-100 [&_:not(pre)>code]:text-orange-700 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-sm [&_table]:w-full [&_table]:border [&_table]:border-zinc-200 [&_table]:rounded-xl [&_table]:overflow-hidden [&_th]:bg-zinc-50 [&_th]:text-zinc-700 [&_th]:font-semibold [&_th]:text-left [&_th]:p-3 [&_td]:p-3 [&_td]:border-t [&_td]:border-zinc-200 [&_img]:rounded-xl [&_img]:border [&_img]:border-zinc-200/80 [&_img]:shadow-sm">
          <Content />
        </div>
      </article>
    </div>
    {tableOfContents.length > 0 && (
      <aside class="hidden lg:block sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pl-2" aria-label="On this page">
        <p class="sticky top-0 z-10 m-0 mb-4 pb-2 text-[10px] font-bold font-mono tracking-wider uppercase text-zinc-600 bg-zinc-50">
          On this page
        </p>
        <ul class="m-0 p-0 pl-3 list-none border-l border-zinc-200 grid gap-2">
          {tableOfContents.map((item) => (
            <li class:list={[{ 'pl-3': item.depth === 2 }]}>
              <a
                href={`#${item.id}`}
                class="block text-sm text-zinc-600 hover:text-zinc-800 transition-colors no-underline toc-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </section>
</Layout>

<script is:inline>
  (() => {
    const content = document.querySelector('.blog-content');
    if (!content) return;

    const inferTabLabel = (pre, index, language) => {
      const firstLine = (pre.textContent || '')
        .split('\n')
        .map((line) => line.trim())
        .find(Boolean);

      const command = (firstLine || '')
        .replace(/^[$>#]\s*/, '')
        .split(/\s+/)[0]
        ?.toLowerCase();

      const commandLabels = {
        brew: 'brew',
        bun: 'bun',
        cargo: 'cargo',
        curl: 'curl',
        deno: 'deno',
        docker: 'docker',
        npm: 'npm',
        pnpm: 'pnpm',
        powershell: 'powershell',
        pwsh: 'powershell',
        scoop: 'scoop',
        yarn: 'yarn',
      };

      if (command && commandLabels[command]) {
        return commandLabels[command];
      }

      if (language && language !== 'plaintext') {
        return language.toLowerCase();
      }

      return `option ${index + 1}`;
    };

    const buildCodeTabs = (group, groupIndex, explicitLabels = []) => {
      if (group.length < 2) return;

      const parent = group[0].parentElement;
      if (!parent) return;
      const insertionPoint = group[0];

      const container = document.createElement('section');
      container.className = 'code-tabs';

      const tabList = document.createElement('div');
      tabList.className = 'code-tab-list';
      tabList.setAttribute('role', 'tablist');

      const panels = document.createElement('div');
      panels.className = 'code-tab-panels';

      const labelCounts = new Map();
      parent.insertBefore(container, insertionPoint);

      group.forEach((pre, itemIndex) => {
        const language = pre.getAttribute('data-language') || 'plaintext';
        const explicitLabel = explicitLabels[itemIndex]?.trim();
        const baseLabel =
          explicitLabel && explicitLabel.length > 0
            ? explicitLabel
            : inferTabLabel(pre, itemIndex, language);
        const seen = labelCounts.get(baseLabel) || 0;
        labelCounts.set(baseLabel, seen + 1);
        const label = seen === 0 ? baseLabel : `${baseLabel} ${seen + 1}`;

        const tabId = `code-tab-${groupIndex}-${itemIndex}`;
        const panelId = `code-tab-panel-${groupIndex}-${itemIndex}`;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-tab-trigger';
        button.id = tabId;
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-controls', panelId);
        button.setAttribute('aria-selected', itemIndex === 0 ? 'true' : 'false');
        button.tabIndex = itemIndex === 0 ? 0 : -1;
        button.textContent = label;

        const panel = document.createElement('div');
        panel.className = 'code-tab-panel';
        panel.id = panelId;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tabId);
        panel.hidden = itemIndex !== 0;
        panel.appendChild(pre);

        button.addEventListener('click', () => {
          const triggers = tabList.querySelectorAll('.code-tab-trigger');
          const tabPanels = panels.querySelectorAll('.code-tab-panel');

          triggers.forEach((trigger, triggerIndex) => {
            const isActive = triggerIndex === itemIndex;
            trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
            trigger.tabIndex = isActive ? 0 : -1;
          });

          tabPanels.forEach((tabPanel, panelIndex) => {
            tabPanel.hidden = panelIndex !== itemIndex;
          });
        });

        tabList.appendChild(button);
        panels.appendChild(panel);
      });

      container.appendChild(tabList);
      container.appendChild(panels);
    };

    const directChildren = Array.from(content.children);
    let pointer = 0;
    let groupIndex = 0;
    const tabMarkerPattern = /^\[!code-tabs\s+(.+)\]$/i;
    const parseLabels = (raw) =>
      raw
        .split(/[|,]/)
        .map((label) => label.trim())
        .filter(Boolean);

    while (pointer < directChildren.length) {
      const current = directChildren[pointer];

      if (current.tagName === 'P') {
        const text = (current.textContent || '').trim();
        const markerMatch = text.match(tabMarkerPattern);

        if (markerMatch) {
          const explicitLabels = parseLabels(markerMatch[1]);
          const preGroup = [];
          let cursor = pointer + 1;

          while (cursor < directChildren.length && directChildren[cursor].tagName === 'PRE') {
            preGroup.push(directChildren[cursor]);
            cursor += 1;
          }

          if (preGroup.length >= 2) {
            buildCodeTabs(preGroup, groupIndex, explicitLabels);
            current.remove();
            groupIndex += 1;
            pointer = cursor;
            continue;
          }
        }
      }

      if (current.tagName !== 'PRE') {
        pointer += 1;
        continue;
      }

      const preGroup = [];
      let cursor = pointer;

      while (cursor < directChildren.length && directChildren[cursor].tagName === 'PRE') {
        preGroup.push(directChildren[cursor]);
        cursor += 1;
      }

      buildCodeTabs(preGroup, groupIndex);
      groupIndex += 1;
      pointer = cursor;
    }

    const copyText = async (text) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Fall through to legacy copy path.
        }
      }

      try {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', 'true');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        document.body.removeChild(textarea);
        return copied;
      } catch {
        return false;
      }
    };

    const enhanceCodeBlockWithCopy = (pre) => {
      if (!(pre instanceof HTMLElement) || pre.dataset.copyButtonReady === 'true') {
        return;
      }

      pre.dataset.copyButtonReady = 'true';
      pre.classList.add('has-copy-button');

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-button';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code to clipboard');

      const resetState = () => {
        button.classList.remove('is-copied', 'is-failed');
        button.textContent = 'Copy';
      };

      let resetTimerId = null;

      button.addEventListener('click', async () => {
        const codeNode = pre.querySelector('code');
        const codeText = (codeNode?.textContent ?? pre.textContent ?? '').replace(/\n$/, '');
        const copied = await copyText(codeText);

        if (resetTimerId !== null) {
          window.clearTimeout(resetTimerId);
        }

        if (copied) {
          button.classList.remove('is-failed');
          button.classList.add('is-copied');
          button.textContent = 'Copied';
        } else {
          button.classList.remove('is-copied');
          button.classList.add('is-failed');
          button.textContent = 'Failed';
        }

        resetTimerId = window.setTimeout(resetState, 1400);
      });

      pre.appendChild(button);
    };

    content.querySelectorAll('pre').forEach(enhanceCodeBlockWithCopy);

    const setupTocSpy = () => {
      const toc = document.querySelector('aside[aria-label="On this page"]');
      if (!toc) return;

      const items = Array.from(toc.querySelectorAll('a[href^="#"]'))
        .map((link) => {
          const id = decodeURIComponent((link.getAttribute('href') || '').slice(1));
          return {
            id,
            link,
            section: document.getElementById(id),
          };
        })
        .filter((item) => item.section);

      if (items.length === 0) return;

      let activeId = '';

      const setActive = (nextId) => {
        if (!nextId || nextId === activeId) return;
        activeId = nextId;

        items.forEach((item) => {
          const isActive = item.id === nextId;
          item.link.classList.toggle('text-zinc-800', isActive);
          item.link.classList.toggle('font-semibold', isActive);
          item.link.classList.toggle('text-zinc-600', !isActive);
        });
      };

      const updateActive = () => {
        const topOffset = window.scrollY + 180;
        let currentId = items[0].id;

        items.forEach((item) => {
          if (item.section.offsetTop <= topOffset) {
            currentId = item.id;
          }
        });

        setActive(currentId);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateActive();
    };

    setupTocSpy();

    const getTweetInfo = (href) => {
      try {
        const url = new URL(href, window.location.origin);
        const hostname = url.hostname.replace(/^www\./, '');

        if (hostname !== 'twitter.com' && hostname !== 'x.com') {
          return null;
        }

        const match = url.pathname.match(/^\/([^/]+)\/status\/(\d+)/);
        if (!match) return null;

        return {
          tweetId: match[2],
          canonicalUrl: `https://twitter.com/${match[1]}/status/${match[2]}`,
        };
      } catch {
        return null;
      }
    };

    const createTweetEmbedElement = (tweetInfo) => {
      const embed = document.createElement('figure');
      embed.className = 'tweet-embed';
      embed.dataset.tweetId = tweetInfo.tweetId;

      const fallbackLink = document.createElement('a');
      fallbackLink.href = tweetInfo.canonicalUrl;
      fallbackLink.target = '_blank';
      fallbackLink.rel = 'noreferrer noopener';
      fallbackLink.textContent = 'View post on X';
      embed.appendChild(fallbackLink);

      return embed;
    };

    const getYouTubeInfo = (href) => {
      try {
        const url = new URL(href, window.location.origin);
        const hostname = url.hostname.replace(/^www\./, '');
        let videoId = '';

        if (hostname === 'youtu.be') {
          videoId = url.pathname.split('/').filter(Boolean)[0] ?? '';
        } else if (
          hostname === 'youtube.com' ||
          hostname === 'm.youtube.com' ||
          hostname === 'youtube-nocookie.com'
        ) {
          if (url.pathname === '/watch') {
            videoId = url.searchParams.get('v') ?? '';
          } else if (url.pathname.startsWith('/shorts/')) {
            videoId = url.pathname.split('/')[2] ?? '';
          } else if (url.pathname.startsWith('/embed/')) {
            videoId = url.pathname.split('/')[2] ?? '';
          }
        }

        if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) {
          return null;
        }

        return {
          videoId,
          canonicalUrl: `https://www.youtube.com/watch?v=${videoId}`,
        };
      } catch {
        return null;
      }
    };

    const createYouTubeEmbedElement = (videoInfo) => {
      const embed = document.createElement('figure');
      embed.className = 'video-embed';

      const iframe = document.createElement('iframe');
      iframe.className = 'video-embed-frame';
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoInfo.videoId}?rel=0`;
      iframe.title = 'Embedded YouTube video';
      iframe.loading = 'lazy';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;

      embed.appendChild(iframe);
      return embed;
    };

    const ensureTwitterWidgets = () => {
      if (window.twttr?.widgets?.createTweet) {
        return Promise.resolve(window.twttr);
      }

      const existingScript = document.querySelector('script[data-twitter-widgets]');
      if (existingScript) {
        return new Promise((resolve) => {
          existingScript.addEventListener('load', () => resolve(window.twttr), { once: true });
          existingScript.addEventListener('error', () => resolve(null), { once: true });
        });
      }

      return new Promise((resolve) => {
        const script = document.createElement('script');
        script.src = 'https://platform.twitter.com/widgets.js';
        script.async = true;
        script.setAttribute('data-twitter-widgets', 'true');
        script.addEventListener('load', () => resolve(window.twttr), { once: true });
        script.addEventListener('error', () => resolve(null), { once: true });
        document.body.appendChild(script);
      });
    };

    const hydrateTweetEmbeds = (twttr, embeds) => {
      if (!twttr?.widgets?.createTweet) return;

      embeds.forEach((embed) => {
        const tweetId = embed.dataset.tweetId;
        if (!tweetId) return;

        const fallbackLink = embed.querySelector('a');
        embed.textContent = '';

        twttr.widgets
          .createTweet(tweetId, embed, {
            dnt: true,
            align: 'center',
            lang: 'en',
          })
          .catch(() => {
            if (fallbackLink) {
              embed.textContent = '';
              embed.appendChild(fallbackLink);
            }
          });
      });
    };

    let embeddedTweetCount = 0;
    const embeddedTweetNodes = [];
    const extractTweetUrlFromMarker = (rawText) => {
      const markerMatch = rawText.match(/^\[!tweet\s+(.+)\]$/i);
      if (!markerMatch) return null;

      const urlMatch = markerMatch[1].match(
        /https?:\/\/(?:www\.)?(?:twitter\.com|x\.com)\/[^\s\]]+/i,
      );

      return urlMatch ? urlMatch[0] : null;
    };

    const extractYouTubeUrlFromMarker = (rawText) => {
      const markerMatch = rawText.match(/^\[!youtube\s+(.+)\]$/i);
      if (!markerMatch) return null;

      const urlMatch = markerMatch[1].match(
        /https?:\/\/(?:www\.|m\.)?(?:youtube\.com|youtu\.be|youtube-nocookie\.com)\/[^\s\]]+/i,
      );

      return urlMatch ? urlMatch[0] : null;
    };

    content.querySelectorAll('p').forEach((paragraph) => {
      const markerUrl = extractYouTubeUrlFromMarker((paragraph.textContent || '').trim());
      if (!markerUrl) return;

      const videoInfo = getYouTubeInfo(markerUrl);
      if (!videoInfo) return;

      paragraph.replaceWith(createYouTubeEmbedElement(videoInfo));
    });

    content.querySelectorAll('p').forEach((paragraph) => {
      const markerUrl = extractTweetUrlFromMarker((paragraph.textContent || '').trim());
      if (!markerUrl) return;

      const tweetInfo = getTweetInfo(markerUrl);
      if (!tweetInfo) return;

      const embedNode = createTweetEmbedElement(tweetInfo);
      paragraph.replaceWith(embedNode);
      embeddedTweetNodes.push(embedNode);
      embeddedTweetCount += 1;
    });

    const tweetLinks = content.querySelectorAll('a[href*="/status/"]');

    tweetLinks.forEach((link) => {
      const tweetInfo = getTweetInfo(link.href);
      if (!tweetInfo) return;

      const paragraph = link.closest('p');
      if (!paragraph) return;

      if (paragraph.nextElementSibling?.classList.contains('tweet-embed')) {
        return;
      }

      const embedNode = createTweetEmbedElement(tweetInfo);
      paragraph.insertAdjacentElement('afterend', embedNode);
      embeddedTweetNodes.push(embedNode);
      embeddedTweetCount += 1;
    });

    if (embeddedTweetCount === 0) {
      return;
    }

    ensureTwitterWidgets().then((twttr) => {
      hydrateTweetEmbeds(twttr, embeddedTweetNodes);
    });
  })();
</script>
