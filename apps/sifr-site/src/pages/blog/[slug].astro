---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const { Content, headings } = await post.render();

const readingMinutes = estimateReadingMinutes(post.body);

const tableOfContents = headings
  .filter((heading) => heading.depth === 1 || heading.depth === 2)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    depth: heading.depth as 1 | 2,
  }));

const canonicalPath = `/blog/${post.slug}`;
const articlePublished = post.data.date.toISOString();
const articleModified = (post.data.updated ?? post.data.date).toISOString();
const articleKeywords = ['sifr', 'blog', ...(post.data.keywords ?? [])];
---

<Layout
  title={`${post.data.title} | Sifr blog`}
  description={post.data.excerpt}
  canonical={canonicalPath}
  image={post.data.ogImage ?? '/logo.webp'}
  imageAlt={post.data.ogImageAlt ?? post.data.title}
  type="article"
  author={post.data.author}
  publishedTime={articlePublished}
  modifiedTime={articleModified}
  keywords={articleKeywords}
  stickyHeader={false}
>
  <section class="blog-post-shell">
    <div class="blog-post-wrapper">
      <article class="blog-article">
        <header class="blog-header">
          <p class="blog-eyebrow">{post.data.eyebrow ?? 'Engineering Notes'}</p>
          <h1>{post.data.title}</h1>
          <div class="blog-meta">
            <time datetime={post.data.date.toISOString()}>
              {
                post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
            <span class="blog-meta-divider" aria-hidden="true">•</span>
            <span>{readingMinutes} min read</span>
            {post.data.author && (
              <>
                <span class="blog-meta-divider" aria-hidden="true">•</span>
                <span class="blog-author">By {post.data.author}</span>
              </>
            )}
          </div>
        </header>
        <div class="blog-content">
          <Content />
        </div>
      </article>
    </div>
    {tableOfContents.length > 0 && (
      <aside class="blog-toc" aria-label="On this page">
        <p class="blog-toc-title">On this page</p>
        <ul>
          {tableOfContents.map((item) => (
            <li class:list={{ 'toc-subitem': item.depth === 2 }}>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </section>
</Layout>

<script is:inline>
  (() => {
    const content = document.querySelector('.blog-content');
    if (!content) return;

    const inferTabLabel = (pre, index, language) => {
      const firstLine = (pre.textContent || '')
        .split('\n')
        .map((line) => line.trim())
        .find(Boolean);

      const command = (firstLine || '')
        .replace(/^[$>#]\s*/, '')
        .split(/\s+/)[0]
        ?.toLowerCase();

      const commandLabels = {
        brew: 'brew',
        bun: 'bun',
        cargo: 'cargo',
        curl: 'curl',
        deno: 'deno',
        docker: 'docker',
        npm: 'npm',
        pnpm: 'pnpm',
        powershell: 'powershell',
        pwsh: 'powershell',
        scoop: 'scoop',
        yarn: 'yarn',
      };

      if (command && commandLabels[command]) {
        return commandLabels[command];
      }

      if (language && language !== 'plaintext') {
        return language.toLowerCase();
      }

      return `option ${index + 1}`;
    };

    const buildCodeTabs = (group, groupIndex, explicitLabels = []) => {
      if (group.length < 2) return;

      const parent = group[0].parentElement;
      if (!parent) return;
      const insertionPoint = group[0];

      const container = document.createElement('section');
      container.className = 'code-tabs';

      const tabList = document.createElement('div');
      tabList.className = 'code-tab-list';
      tabList.setAttribute('role', 'tablist');

      const panels = document.createElement('div');
      panels.className = 'code-tab-panels';

      const labelCounts = new Map();
      parent.insertBefore(container, insertionPoint);

      group.forEach((pre, itemIndex) => {
        const language = pre.getAttribute('data-language') || 'plaintext';
        const explicitLabel = explicitLabels[itemIndex]?.trim();
        const baseLabel =
          explicitLabel && explicitLabel.length > 0
            ? explicitLabel
            : inferTabLabel(pre, itemIndex, language);
        const seen = labelCounts.get(baseLabel) || 0;
        labelCounts.set(baseLabel, seen + 1);
        const label = seen === 0 ? baseLabel : `${baseLabel} ${seen + 1}`;

        const tabId = `code-tab-${groupIndex}-${itemIndex}`;
        const panelId = `code-tab-panel-${groupIndex}-${itemIndex}`;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-tab-trigger';
        button.id = tabId;
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-controls', panelId);
        button.setAttribute('aria-selected', itemIndex === 0 ? 'true' : 'false');
        button.tabIndex = itemIndex === 0 ? 0 : -1;
        button.textContent = label;

        const panel = document.createElement('div');
        panel.className = 'code-tab-panel';
        panel.id = panelId;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tabId);
        panel.hidden = itemIndex !== 0;
        panel.appendChild(pre);

        button.addEventListener('click', () => {
          const triggers = tabList.querySelectorAll('.code-tab-trigger');
          const tabPanels = panels.querySelectorAll('.code-tab-panel');

          triggers.forEach((trigger, triggerIndex) => {
            const isActive = triggerIndex === itemIndex;
            trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
            trigger.tabIndex = isActive ? 0 : -1;
          });

          tabPanels.forEach((tabPanel, panelIndex) => {
            tabPanel.hidden = panelIndex !== itemIndex;
          });
        });

        tabList.appendChild(button);
        panels.appendChild(panel);
      });

      container.appendChild(tabList);
      container.appendChild(panels);
    };

    const directChildren = Array.from(content.children);
    let pointer = 0;
    let groupIndex = 0;
    const tabMarkerPattern = /^\[!code-tabs\s+(.+)\]$/i;
    const parseLabels = (raw) =>
      raw
        .split(/[|,]/)
        .map((label) => label.trim())
        .filter(Boolean);

    while (pointer < directChildren.length) {
      const current = directChildren[pointer];

      if (current.tagName === 'P') {
        const text = (current.textContent || '').trim();
        const markerMatch = text.match(tabMarkerPattern);

        if (markerMatch) {
          const explicitLabels = parseLabels(markerMatch[1]);
          const preGroup = [];
          let cursor = pointer + 1;

          while (cursor < directChildren.length && directChildren[cursor].tagName === 'PRE') {
            preGroup.push(directChildren[cursor]);
            cursor += 1;
          }

          if (preGroup.length >= 2) {
            buildCodeTabs(preGroup, groupIndex, explicitLabels);
            current.remove();
            groupIndex += 1;
            pointer = cursor;
            continue;
          }
        }
      }

      if (current.tagName !== 'PRE') {
        pointer += 1;
        continue;
      }

      const preGroup = [];
      let cursor = pointer;

      while (cursor < directChildren.length && directChildren[cursor].tagName === 'PRE') {
        preGroup.push(directChildren[cursor]);
        cursor += 1;
      }

      buildCodeTabs(preGroup, groupIndex);
      groupIndex += 1;
      pointer = cursor;
    }

    const setupTocSpy = () => {
      const toc = document.querySelector('.blog-toc');
      if (!toc) return;

      const items = Array.from(toc.querySelectorAll('a[href^="#"]'))
        .map((link) => {
          const id = decodeURIComponent((link.getAttribute('href') || '').slice(1));
          return {
            id,
            link,
            section: document.getElementById(id),
          };
        })
        .filter((item) => item.section);

      if (items.length === 0) return;

      let activeId = '';

      const setActive = (nextId) => {
        if (!nextId || nextId === activeId) return;
        activeId = nextId;

        items.forEach((item) => {
          const isActive = item.id === nextId;
          item.link.classList.toggle('is-active', isActive);
          item.link.parentElement?.classList.toggle('is-active', isActive);
        });
      };

      const updateActive = () => {
        const topOffset = window.scrollY + 180;
        let currentId = items[0].id;

        items.forEach((item) => {
          if (item.section.offsetTop <= topOffset) {
            currentId = item.id;
          }
        });

        setActive(currentId);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateActive();
    };

    setupTocSpy();

    const normalizeTweetUrl = (href) => {
      try {
        const url = new URL(href, window.location.origin);
        const hostname = url.hostname.replace(/^www\./, '');

        if (hostname !== 'twitter.com' && hostname !== 'x.com') {
          return null;
        }

        const match = url.pathname.match(/^\/([^/]+)\/status\/(\d+)/);
        if (!match) return null;

        return `https://twitter.com/${match[1]}/status/${match[2]}`;
      } catch {
        return null;
      }
    };

    const createTweetEmbedElement = (tweetUrl) => {
      const embed = document.createElement('figure');
      embed.className = 'tweet-embed';

      const iframe = document.createElement('iframe');
      iframe.className = 'tweet-embed-frame';
      iframe.title = 'Embedded X post';
      iframe.loading = 'lazy';
      iframe.src = `https://twitframe.com/show?url=${encodeURIComponent(tweetUrl)}`;
      iframe.setAttribute('scrolling', 'no');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allowtransparency', 'true');

      embed.appendChild(iframe);
      return embed;
    };

    let embeddedTweetCount = 0;
    const extractTweetUrlFromMarker = (rawText) => {
      const markerMatch = rawText.match(/^\[!tweet\s+(.+)\]$/i);
      if (!markerMatch) return null;

      const urlMatch = markerMatch[1].match(
        /https?:\/\/(?:www\.)?(?:twitter\.com|x\.com)\/[^\s\]]+/i,
      );

      return urlMatch ? urlMatch[0] : null;
    };

    content.querySelectorAll('p').forEach((paragraph) => {
      const markerUrl = extractTweetUrlFromMarker((paragraph.textContent || '').trim());
      if (!markerUrl) return;

      const tweetUrl = normalizeTweetUrl(markerUrl);
      if (!tweetUrl) return;

      paragraph.replaceWith(createTweetEmbedElement(tweetUrl));
      embeddedTweetCount += 1;
    });

    const tweetLinks = content.querySelectorAll('a[href*="/status/"]');

    tweetLinks.forEach((link) => {
      const tweetUrl = normalizeTweetUrl(link.href);
      if (!tweetUrl) return;

      const paragraph = link.closest('p');
      if (!paragraph) return;

      if (paragraph.nextElementSibling?.classList.contains('tweet-embed')) {
        return;
      }

      paragraph.insertAdjacentElement('afterend', createTweetEmbedElement(tweetUrl));
      embeddedTweetCount += 1;
    });

    if (embeddedTweetCount === 0) return;
  })();
</script>
