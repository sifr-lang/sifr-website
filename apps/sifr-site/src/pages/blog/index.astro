---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';

const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date): string =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const postsWithMeta = posts.map((post: CollectionEntry<'blog'>) => ({
  post,
  readingMinutes: estimateReadingMinutes(post.body),
}));
---

<Layout
  title="Sifr Blog"
  description="Release notes, language engineering notes, and practical development workflows for Sifr."
  canonical="/blog"
  image="/logo.webp"
  imageAlt="Sifr blog"
  keywords={['sifr', 'blog', 'release notes', 'language engineering']}
>
  <section class="flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-3xl">
      <span class="text-xs font-bold font-mono tracking-wider text-sky-700 uppercase">Engineering Notes</span>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-950">Blog</h1>
      <p class="text-zinc-600 text-base md:text-lg leading-relaxed">
        Release notes, language engineering notes, and practical development workflows for Sifr.
      </p>
    </div>

    <ul class="grid gap-4 list-none m-0 p-0">
      {postsWithMeta.map(({ post, readingMinutes }) => (
        <li>
          <a
            class="group block bg-white border border-zinc-200/80 rounded-2xl p-6 md:p-7 shadow-sm hover:border-zinc-300 hover:shadow-md transition-all no-underline"
            href={`/blog/${post.id}`}
          >
            <p class="m-0 mb-2 text-[11px] font-bold font-mono tracking-wider uppercase text-sky-700">
              {post.data.eyebrow ?? 'Engineering Notes'}
            </p>
            <h2 class="m-0 mb-3 font-display text-xl md:text-2xl font-bold tracking-tight text-zinc-950 group-hover:text-sky-700 transition-colors">
              {post.data.title}
            </h2>
            <div class="flex flex-wrap items-center gap-2 mb-3 text-sm font-medium text-zinc-600">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true">•</span>
              <span>{readingMinutes} min read</span>
              {post.data.author && (
                <>
                  <span aria-hidden="true">•</span>
                  <span class="text-zinc-700">By {post.data.author}</span>
                </>
              )}
            </div>
            <p class="m-0 text-zinc-600 text-sm md:text-base leading-relaxed">{post.data.excerpt}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-sky-700 group-hover:text-sky-800">
              Read article
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
