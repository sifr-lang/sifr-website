---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';

const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date): string =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const postsWithMeta = posts.map((post: CollectionEntry<'blog'>) => ({
  post,
  readingMinutes: estimateReadingMinutes(post.body),
}));
---

<Layout
  title="Sifr Blog"
  description="Release notes, language engineering notes, and practical development workflows for Sifr."
  canonical="/blog"
  image="/logo.webp"
  imageAlt="Sifr blog"
  keywords={['sifr', 'blog', 'release notes', 'language engineering']}
>
  <section class="blog-index">
    <h1>Blog</h1>
    <ul class="blog-list">
      {postsWithMeta.map(({ post, readingMinutes }) => (
        <li>
          <a class="blog-card" href={`/blog/${post.slug}`}>
            <p class="blog-card-eyebrow">{post.data.eyebrow ?? 'Engineering Notes'}</p>
            <h2 class="blog-title">{post.data.title}</h2>
            <div class="blog-card-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="blog-card-meta-divider" aria-hidden="true">•</span>
              <span>{readingMinutes} min read</span>
              {post.data.author && (
                <>
                  <span class="blog-card-meta-divider" aria-hidden="true">•</span>
                  <span class="blog-card-author">By {post.data.author}</span>
                </>
              )}
            </div>
            <p class="blog-readme">{post.data.excerpt}</p>
            <span class="blog-read-link">Read article →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
