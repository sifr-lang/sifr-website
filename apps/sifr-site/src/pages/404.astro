---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../components/Layout.astro';

const latestPosts = (await getCollection('blog'))
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.date.valueOf() - a.data.date.valueOf(),
  )
  .slice(0, 3);
---

<Layout
  title="Page not found | Sifr"
  description="The page you requested could not be found. Continue exploring Sifr from the homepage or blog."
  canonical="/404"
  image="/logo.webp"
  imageAlt="Sifr logo"
  noindex={true}
>
  <section class="relative flex flex-col items-center justify-center min-h-[55vh] py-8" aria-labelledby="not-found-title">
    <div class="absolute top-0 left-0 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-0 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative w-full max-w-2xl text-center bg-white border border-zinc-200/80 rounded-3xl p-8 md:p-12 shadow-sm">
      <p class="m-0 font-display text-6xl md:text-8xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-blue-700" aria-hidden="true">
        404
      </p>
      <p class="mt-4 mb-2 text-xs font-bold font-mono tracking-wider uppercase text-sky-600">
        Looks like this path does not exist.
      </p>
      <h1 id="not-found-title" class="m-0 font-display text-2xl md:text-3xl font-extrabold text-zinc-950">
        Page not found
      </h1>
      <p class="mt-3 mb-0 text-zinc-500 text-sm md:text-base leading-relaxed max-w-md mx-auto">
        The link may be outdated, moved, or typed incorrectly. Use one of the paths below to keep moving.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-medium rounded-xl transition-colors no-underline"
        >
          Go to homepage
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-sky-50 text-sky-700 hover:bg-sky-100 text-sm font-medium rounded-xl border border-sky-200/60 transition-colors no-underline"
        >
          Read the blog
        </a>
      </div>

      {latestPosts.length > 0 && (
        <div class="mt-10 pt-6 border-t border-zinc-200/80 text-left" aria-label="Latest blog posts">
          <p class="m-0 mb-3 text-[10px] font-bold font-mono tracking-wider uppercase text-zinc-400">
            Latest posts
          </p>
          <ul class="m-0 p-0 list-none grid gap-2">
            {latestPosts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.slug}`}
                  class="text-sm font-semibold text-zinc-700 hover:text-sky-600 transition-colors no-underline hover:underline"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Layout>
